# PostgreSQL (docker-compose 기본값)
DATABASE_URL="postgresql://starter:starter@localhost:5432/starter?schema=public"

# Redis (비워두면 메모리 기반으로 동작 - 단일 인스턴스 개발용)
REDIS_URL="redis://localhost:6379"

# Better Auth: `npx @better-auth/cli secret` 또는 `openssl rand -base64 32` 로 생성
BETTER_AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# 시드 관리자 계정
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin1234!"

# 로그 레벨: trace | debug | info | warn | error
LOG_LEVEL="info"
