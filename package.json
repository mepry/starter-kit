{
  "name": "starter-kit",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:clean": "npm run clean -w web && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "db:generate": "npm run db:generate -w @repo/db",
    "db:migrate": "npm run db:migrate -w @repo/db",
    "db:deploy": "npm run db:deploy -w @repo/db",
    "db:seed": "npm run db:seed -w @repo/db",
    "db:studio": "npm run db:studio -w @repo/db",
    "test:e2e": "npm run test:e2e -w web",
    "postinstall": "npm run db:generate"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
